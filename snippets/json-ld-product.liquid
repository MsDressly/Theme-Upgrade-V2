<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.images.size > 0 -%}
  "image": [
    {%- for image in product.images limit:5 -%}
      {{ image | img_url: 'master' | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif -%}
  "description": {{ product.description | strip_html | json }},
  {%- if product.variants.first.sku != blank -%}
  "sku": {{ product.variants.first.sku | json }},
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": "MsDressly"
  },
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      {%- if variant.sku != blank -%}
      "sku": {{ variant.sku | json }},
      {%- endif -%}
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ shop.currency | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "url": {{ shop.url | append: variant.url | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- assign rating = product.metafields.judgeme.rating -%}
  {%- assign rating_count = product.metafields.judgeme.review_count -%}
  {%- if rating and rating_count -%}
  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating | json }},
    "reviewCount": {{ rating_count | json }}
  }
  {%- endif -%}
}
</script>
