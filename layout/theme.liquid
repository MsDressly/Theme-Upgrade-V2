<!doctype html>
<html class="no-js supports-no-cookies" lang="{{ shop.locale }}"{% if shop.locale == 'ar' or shop.locale == 'he' or settings.layout_enable_rtl %} dir="rtl"{% endif %}>

<head>
  <!-- DNS prefetch for external domains -->
  <link rel="dns-prefetch" href="//fonts.googleapis.com">
  <link rel="dns-prefetch" href="//www.googletagmanager.com">
  <link rel="dns-prefetch" href="//www.google-analytics.com">
  <link rel="dns-prefetch" href="//cdn.shopify.com">
  <link rel="dns-prefetch" href="//fonts.shopifycdn.com">
  <link rel="dns-prefetch" href="//monorail-edge.shopifysvc.com">
  <link rel="dns-prefetch" href="//shopify-trekkie.global.ssl.fastly.net">
  
  <!-- Preconnect to external domains -->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
  
  

  <!-- Preload critical resources with high priority -->
  {{ 'theme-d.s.min.css' | asset_url | stylesheet_tag: preload: true }}
  {{ 'theme.s.min.js' | asset_url | preload_tag: as: 'script' }}
  
  <!-- Optimized Critical inline CSS for above-the-fold content -->
  <style>
    :root{--base-family:"Basic Commercial",sans-serif;--theme:#17344A;--theme2:#ffffff;--theme-body:var(--theme2);--theme-c:#5D7180;--theme-primary:#5a31f4;--header-m-bg:var(--theme2)}
    body{font-family:var(--base-family);margin:0;background-color:var(--theme-body);color:var(--theme-c);font-display:swap}
    .header{z-index:3;will-change:transform}
    .header__content{background-color:var(--header-m-bg)}
    .btn{display:inline-flex;justify-content:center;align-items:center;border-radius:14px!important;border:1px solid;min-height:50px;cursor:pointer}
    .container{width:100%;padding:0 10px;margin:0 auto}
    @media(min-width:1025px){.container{max-width:1200px;padding:0 15px}}
    .d-none{display:none!important}
    .preloader{position:absolute;width:100%;height:100%;top:0;left:0;opacity:0;z-index:1;display:flex;justify-content:center;align-items:center;transform:translateZ(0)}
    /* Prevent layout shift */
    img{max-width:100%;height:auto}
    .loading{opacity:0;transition:opacity 0.3s ease}
    .loaded{opacity:1}
  </style>



  <!-- Standard Shopify head content -->
  {{ content_for_header }}
  {% render 'head' %}


  <meta name="google-site-verification" content="NeMJo4pLZqU6IJyez5HR1fHuZ08pEqb-_awCFv8PNvI" />

  <script>
    // Non-critical redirect script - defer execution
    window.addEventListener('DOMContentLoaded', function() {
      var currentUrl = window.location.href;
      if (currentUrl.includes('redit')) {
        var newUrl = currentUrl.replace(/-redit-\d+/, '');
        window.location.href = newUrl;
      }
    });
  </script>

  <!-- Defer non-critical CSS -->
  <noscript><link rel="stylesheet" href="{{ 'theme-d.s.min.css' | asset_url }}"></noscript>

  <!-- MsDressly Custom Styles -->
  {{ 'msdressly-custom.css' | asset_url | stylesheet_tag: preload: true }}
  <noscript><link rel="stylesheet" href="{{ 'msdressly-custom.css' | asset_url }}"></noscript>

  {%- if template contains 'product' -%}
    {%- render 'json-ld-product' -%}
  {%- endif -%}
</head>

<body{% render 'layout-get-body-attributes' %} class="loading">
  <!-- Performance marker -->
  <script>window.performance && window.performance.mark && window.performance.mark('theme:body:start');</script>
  
  {% render 'layout-get-includes-start' %}
  {%- if settings.product_show_custom_options and settings.product_enable_variants_section -%}
    {% section 'product-variants' %}
  {%- endif -%}
  {% sections 'header-group' %}
  <main id="MainContent">
    {%- if request.page_type == 'page' or request.page_type == 'product' or request.page_type == 'cart' or request.page_type == 'list-collections' or request.page_type == 'article' or request.page_type == 'blog' -%}
      {% render 'breadcrumbs' %}
    {%- elsif request.page_type == 'collection' -%}
      <div id="CollectionBreadcrumbs">
        {% render 'breadcrumbs' %}
      </div>
    {%- endif -%}
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'popups' %}
  {% render 'footbar' %}

  {%- if settings.presentation_enable or template == 'product' and settings.product_info_page_show_usage_info_sidebar -%}
    {% render 'fixed-sidebar' %}
  {%- endif -%}

  {% render 'templates' %}
  {% render 'layout-get-includes-end' %}

  <!-- Performance marker -->
  <script>window.performance && window.performance.mark && window.performance.mark('theme:DOM:loaded');</script>

  <!-- Load main JavaScript with optimized loading -->
  <script src="{{ 'theme.s.min.js' | asset_url }}" defer></script>

  <!-- MsDressly Performance Optimizations -->
  <script src="{{ 'msdressly-performance.js' | asset_url }}" defer></script>

  <!-- Optimized third-party scripts loading -->
  <script>
    // Intersection Observer for lazy loading third-party scripts
    function loadThirdPartyScripts() {
      // Google Analytics - Load asynchronously
      (function() {
        var ga = document.createElement('script');
        ga.async = true;
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=AW-398094399';
        document.head.appendChild(ga);
        
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-398094399');
      })();
      
      // Load remaining CSS after critical rendering
      var cssFiles = [
        '{{ "theme-m.s.min.css" | asset_url }}'
      ];

      cssFiles.forEach(function(url) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = url;
        link.media = 'print';
        link.onload = function() { this.media = 'all'; };
        document.head.appendChild(link);
      });

      // Conditional loading of heavy libraries
      {%- comment -%}
      // Fotorama and Revolution Slider assets removed - commenting out to prevent MissingAsset errors
      {%- if template contains 'product' -%}
      // Load Fotorama only on product pages
      if (document.querySelector('.product__photos, .fotorama')) {
        var fotoramaCSS = document.createElement('link');
        fotoramaCSS.rel = 'stylesheet';
        fotoramaCSS.href = '{{ "plugin.fotorama.css" | asset_url }}';
        document.head.appendChild(fotoramaCSS);

        var fotoramaJS = document.createElement('script');
        fotoramaJS.src = '{{ "plugin.fotorama.js" | asset_url }}';
        fotoramaJS.async = true;
        document.body.appendChild(fotoramaJS);
      }
      {%- endif -%}

      // Load Revolution Slider only if present
      if (document.querySelector('.rev_slider')) {
        var revolutionCSS = document.createElement('link');
        revolutionCSS.rel = 'stylesheet';
        revolutionCSS.href = '{{ "plugin.revolution.css" | asset_url }}';
        document.head.appendChild(revolutionCSS);

        var revolutionJS = document.createElement('script');
        revolutionJS.src = '{{ "plugin.revolution.s.min.js" | asset_url }}';
        revolutionJS.async = true;
        document.body.appendChild(revolutionJS);
      }
      {%- endcomment -%}
    }

    // Load third-party scripts after user interaction or page load
    function initializeThirdParty() {
      loadThirdPartyScripts();
      document.removeEventListener('scroll', initializeThirdParty);
      document.removeEventListener('touchstart', initializeThirdParty);
      document.removeEventListener('click', initializeThirdParty);
    }

    // Load immediately if page is already interactive, otherwise wait for user interaction
    if (document.readyState === 'complete') {
      setTimeout(loadThirdPartyScripts, 1000);
    } else {
      window.addEventListener('load', function() {
        setTimeout(loadThirdPartyScripts, 1000);
      });
      // Also load on first user interaction
      document.addEventListener('scroll', initializeThirdParty, { passive: true, once: true });
      document.addEventListener('touchstart', initializeThirdParty, { passive: true, once: true });
      document.addEventListener('click', initializeThirdParty, { passive: true, once: true });
    }
  </script>

  <!-- Deferred app scripts -->

</body>
</html>
