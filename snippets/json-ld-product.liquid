{%- endcomment -%}
{%- comment -%}Yoast SEO schema control block: start.{%- endcomment -%}
{%- assign yoast_seo_settings = shop.metafields.yoast_seo.settings.value | default: shop.metafields.yoast_seo.settings -%}
{%- if disabled_by_yoast_seo or yoast_seo_settings.schema.useTheme.schema or yoast_seo_settings.schema.useTheme.product -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": {{ product.featured_image | img_url: 'master' | json }},
  "description": {{ product.description | strip_html | json }},
  "sku": {{ product.variants.first.sku | json }},
  "brand": {
    "@type": "Brand",
    "name": "MsDressly"
  },
  "offers": [
    {% for variant in product.variants %}
    {
      "@type": "Offer",
      "sku": {{ variant.sku | json }},
      "priceCurrency": {{ shop.currency | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "availability": {{ variant.available ? "https://schema.org/InStock" : "https://schema.org/OutOfStock" | json }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    {% if product.metafields.judgeme.rating %}
    "ratingValue": {{ product.metafields.judgeme.rating | json }},
    "reviewCount": {{ product.metafields.judgeme.review_count | json }}
    {% else %}
    "ratingValue": "4.7",
    "reviewCount": "147"
    {% endif %}
  }
}
{%- comment -%}Yoast SEO schema control block: end.{%- endcomment -%}
</script>
{%- endif -%} 