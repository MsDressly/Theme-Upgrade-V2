<!doctype html>
<html class="no-js supports-no-cookies" lang="{{ shop.locale }}"{% if shop.locale == 'ar' or shop.locale == 'he' or settings.layout_enable_rtl %} dir="rtl"{% endif %}>
<head>
  {{ content_for_header }}
  {% render 'head' %}
</head>
<body{% render 'layout-get-body-attributes' %}>
{% render 'layout-get-includes-start' %}
{% render 'password-page-header' %}
<main role="main" id="MainContent">
  <div class="container">
    {{ content_for_layout }}
  </div>
</main>
{% section 'password-page-footer' %}
{% render 'popups' %}
{% render 'layout-get-includes-end' %}
</body>
</html>


